# Variables de entorno para el backend
# Copia este archivo a .env y rellena los valores

PORT=3000
NODE_ENV=development

# JWT Secret (genera uno seguro en producción)
JWT_SECRET=ratecomic_super_secret_jwt_key_change_in_production_2024
JWT_EXPIRES_IN=7d

# Comic Vine API Key
# Documentación oficial: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=your_comicvine_api_key_here
OPENLIBRARY_ENABLED=true

# Marvel API Keys
# Documentación oficial: https://developer.marvel.com
MARVEL_ENABLED=false
MARVEL_PUBLIC_KEY=your_marvel_public_key_here
MARVEL_PRIVATE_KEY=your_marvel_private_key_here

# Tiempo de caché de detalle en horas
MEDIA_CACHE_HOURS=24

# Tiempo de caché de búsquedas por término, tipo y página
SEARCH_CACHE_HOURS=24

# Base de datos SQLite
DB_PATH=./data/ratecomic.db

# CORS - Origen del frontend
CORS_ORIGIN=http://localhost:4200
# CORS allowlist (separado por comas). Tiene prioridad y admite varios orígenes.
CORS_ALLOWLIST=http://localhost:4200
