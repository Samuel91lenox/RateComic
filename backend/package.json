{
  "name": "ratecomic-backend",
  "version": "1.0.0",
  "description": "RateComic API - Backend Express con SQLite",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:init": "node src/database/init.js",
    "db:backup": "node src/scripts/db-backup.js",
    "db:restore": "node src/scripts/db-restore.js",
    "cache:clean": "node src/scripts/cache-clean.js",
    "cache:stats": "node src/scripts/cache-stats.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest --runInBand test/unit",
    "test:e2e": "jest --runInBand test/e2e"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "ratecomic": "file:..",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
